<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE document SYSTEM "../../../units/schema/template.dtd">
<document>
	<tr>
		<td>
			<cms:var name="$params['domain']"/>
			<input
				type="hidden"
				name="$params['field_name']"
				value="$params['domain']"
				cms:eval="name,value"
				/>
		</td>
		<td class="options">
			<a href="javascript: void(0);" onclick="javascript: ContactForm.remove_domain.call(this);">
				<cms:text constant="delete"/>
			</a>
		</td>
	</tr>
</document>
