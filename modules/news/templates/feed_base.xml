<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE document SYSTEM "../../../units/schema/template.dtd">
<document type="xml1.0">
	<rss version="2.0">
		<channel>
			<title><cms:var name="htmlspecialchars($params['title'][$language], ENT_XML1)"/></title>
			<description><cms:var name="htmlspecialchars($params['description'][$language], ENT_XML1)"/></description>
			<link><cms:var name="htmlspecialchars(URL::make(), ENT_XML1)"/></link>
			<language><cms:var name="$language"/></language>
			<lastBuildDate><cms:var name="date('r', $params['build_date'])"/></lastBuildDate>

			<_news_list
				group="$params['group']"
				limit="$params['news_count']"
				template="feed_item.xml"
				local="1"
				cms:eval="group,limit"
				/>
		</channel>
	</rss>
</document>
