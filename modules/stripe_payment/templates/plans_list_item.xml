<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE document SYSTEM "../../../units/schema/template.dtd">
<document>
	<tr>
		<td>
			<cms:var name="$params['name']"/>
		</td>
		<td class="code">
			<cms:var name="$params['text_id']"/>
		</td>
		<td>
			<cms:var name="$params['interval_count']"/>
			<cms:raw text=" / "/>
			<cms:var name="$params['interval']"/>
		</td>
		<td>
			<cms:var name="$params['price']"/>
			<cms:raw text=" "/>
			<cms:var name="$params['currency']"/>
		</td>
	</tr>
</document>
