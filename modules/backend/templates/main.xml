<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE document SYSTEM "../../../units/schema/template.dtd">
<document>
	<html lang="$language" dir="$language_rtl ? 'rtl' : 'ltr'" cms:eval="lang,dir">
		<head>
			<cms:module
				name="head_tag"
				action="add_to_title"
				value="title"
				cms:constant="value"
				/>
			<cms:module name="head_tag" action="show"/>
			<cms:csrf_token/>
		</head>

		<body>
			<!-- Sprite icons -->
			<cms:sprites/>

			<header>
				<!-- Logo -->
				<div id="logo">
					<img
						src="_BASEURL.'/modules/backend/images/logo_text.svg'"
						alt="Caracal"
						cms:eval="src"
						/>
				</div>

				<!-- Window list -->
				<nav id="window_list"/>

				<!-- Common links -->
				<nav id="common">
					<a href="https://github.com/Way2CU/Caracal/issues" target="_blank">
						<cms:text constant="menu_report_bug" module="backend"/>
					</a>
					<a href="http://webchat.freenode.net/?channels=%23caracal&amp;uio=OT10cnVlJjEwPXRydWUmMTE9MjM218" target="_blank">
						<cms:text constant="menu_help" module="backend"/>
					</a>
				</nav>

				<!-- Language menu -->
				<nav id="language">
					<cms:module
						name="language_menu"
						action="print"
						/>
				</nav>
			</header>

			<section>
				<cms:user>
					<!-- Main menu -->
					<nav id="main">
						<a
							onclick="javascript:this.parentNode.classList.toggle('collapsed')"
							class="collapse-menu"
							>
							<svg><use xlink:href="#icon-collapse"/></svg>
						</a>
						<cms:menu_items/>
					</nav>
				</cms:user>

				<!-- Window container -->
				<div id="container">
					<cms:guest>
						<div id="login_window" class="window">
							<div class="title">
								<cms:svg file="image.svg" symbol="name"/>
								<span><cms:text constant="title_login" module="backend"/></span>
								<a class="button close"/>
							</div>

							<div class="content">
								<cms:module
									name="backend"
									action="login"
									/>
							</div>
						</div>
					</cms:guest>
				</div>
			</section>
		</body>
	</html>
</document>
