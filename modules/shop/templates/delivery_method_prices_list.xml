<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE document SYSTEM "../../../units/schema/template.dtd">
<document>
	<!-- Window Menu -->
	<nav class="window">
		<cms:var name="$params['link_new']"/>
	</nav>

	<!-- List -->
	<table class="list" data-height="250">
		<thead>
			<tr>
				<td style="width: 200px;">
					<cms:text constant="column_value" module="shop"/>
				</td>
				<td class="options">
					<cms:text constant="column_options"/>
				</td>
			</tr>
		</thead>

		<tbody>
			<cms:delivery_prices method="$params['method']" cms:eval="method"/>
		</tbody>
	</table>
</document>
