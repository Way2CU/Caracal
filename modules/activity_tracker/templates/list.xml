<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE document SYSTEM "../../../units/schema/template.dtd">
<document>
	<!-- Window Menu -->
	<nav class="window">
		<cms:var name="$params['link_new']"/>
	</nav>

	<!-- List -->
	<table class="list" data-height="250">
		<thead>
			<tr>
				<td style="width: 200px;">
					<cms:text constant="column_activity" module="activity_tracker"/>
				</td>
				<td style="width: 200px;">
					<cms:text constant="column_function" module="activity_tracker"/>
				</td>
				<td style="width: 70px;">
					<cms:text constant="column_timeout" module="activity_tracker"/>
				</td>
				<td style="width: 100px; text-align: center;">
					<cms:text constant="column_ignore_address" module="activity_tracker"/>
				</td>
				<td class="options">
					<cms:text constant="column_options"/>
				</td>
			</tr>
		</thead>

		<tbody>
			<cms:list/>
		</tbody>
	</table>
</document>
